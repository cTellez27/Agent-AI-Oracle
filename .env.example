# ===================================
# CONFIGURACIÓN DEL AGENTE Y APP
# ===================================
APP_NAME="Agent-AI-Oracle"
APP_ENV="development"
PORT=8501

# ===================================
# VECTOR STORE (ChromaDB / OCI OpenSearch)
# ===================================
VECTOR_STORE_PATH="./data/chroma_db"
COLLECTION_NAME="corporate_knowledge_base"

# ===================================
# OCI CLOUD CONFIGURATION (Oracle Cloud)
# ===================================
OCI_COMPARTMENT_OCID="ocid1.compartment.oc1.."
OCI_REGION="us-ashburn-1"
OCI_CONFIG_FILE="~/.oci/config"
OCI_CONFIG_PROFILE="DEFAULT"
OCI_GENAI_MODEL_ID="cohere.command-r-plus"

# ===================================
# LLM & EMBEDDING FALLBACK API KEYS
# ===================================
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
OPENAI_API_KEY="your-openai-api-key-optional"
GROQ_API_KEY="your-groq-api-key-optional"
